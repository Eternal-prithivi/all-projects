{
  "name": "zenith-desktop",
  "version": "0.1.0",
  "description": "Zenith Cloud Platform — Electron shell loading the live web app",
  "homepage": "https://rajverse.me",
  "private": true,
  "main": "electron/main.js",
  "author": {
    "name": "Zenith",
    "email": "support@rajverse.me"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "me.rajverse.zenith",
    "productName": "Zenith",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "artifactName": "Zenith-${version}.${ext}"
    },
    "dmg": {
      "title": "Zenith ${version}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Zenith.Setup.${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "artifactName": "Zenith-${version}.${ext}",
      "maintainer": "Zenith <support@rajverse.me>"
    },
    "deb": {
      "artifactName": "zenith-desktop_${version}_amd64.deb"
    }
  }
}
