# Production Environment Variables
# Copy this file to .env.production and update with your values

# Environment
ENVIRONMENT=production
DEMO_MODE=false

# URLs (UPDATE WITH YOUR DOMAIN)
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com

# MongoDB Atlas (Free Tier - Create at mongodb.com/cloud/atlas)
MONGO_CONNECTION_STRING=mongodb+srv://username:password@cluster.mongodb.net/
MONGO_DB_NAME=zenith_production

# JWT (GENERATE NEW SECRET: openssl rand -hex 32)
SECRET_KEY=your-production-jwt-secret-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis Cloud (Free Tier - Create at redis.com/try-free)
CELERY_BROKER_URL=rediss://default:password@redis-xxxxx.cloud.redislabs.com:xxxxx
REDIS_URL=rediss://default:password@redis-xxxxx.cloud.redislabs.com:xxxxx

# AWS Credentials (Keep your existing keys)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name
PRIMARY_S3_REGION=ap-south-1
REGULAR_S3_BUCKET_NAME=your-regular-bucket
SECURE_S3_BUCKET_NAME=your-secure-bucket
REPLICA_S3_BUCKET_NAME=your-replica-bucket
REPLICA_S3_REGION=us-west-2

# GCP Credentials (Keep your existing values)
GCP_PROJECT_ID=your-gcp-project-id
GCP_ZONE=us-central1-a
GCP_SERVICE_ACCOUNT_JSON_PATH=/app/gcp-key.json
GCP_BUCKET_NAME=your-gcp-bucket
GCP_REPLICA_BUCKET_NAME=your-gcp-replica-bucket
PERFORMANCE_CLUSTER_MAX_VMS=2
STORAGE_CLUSTER_MAX_VMS=2
PERFORMANCE_VM_MACHINE_TYPE=e2-micro
STORAGE_VM_MACHINE_TYPE=e2-micro
STORAGE_VM_DISK_SIZE_GB=20
USE_REAL_METRICS=false

# Azure Credentials (Keep your existing values)
AZURE_STORAGE_ACCOUNT_NAME=your_azure_account
AZURE_STORAGE_ACCOUNT_KEY=your_azure_key
AZURE_CONTAINER_NAME=your-container
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Twilio (Optional - for SMS alerts)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# API Configuration
API_PORT=8000
