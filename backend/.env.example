# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017/cloud_optimization

# AWS Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_ZONE=us-central1-a
GCP_SERVICE_ACCOUNT_JSON_PATH=/path/to/service-account.json

# GCP Billing (for Cost Analysis)
GCP_BILLING_DATASET_ID=billing_dataset
GCP_BILLING_TABLE_ID=gcp_billing_export_v1_XXXXXX

# Azure Credentials
AZURE_STORAGE_CONNECTION_STRING=your_azure_connection_string
AZURE_STORAGE_ACCOUNT_NAME=your_account_name
AZURE_STORAGE_ACCOUNT_KEY=your_account_key
AZURE_STORAGE_CONTAINER_NAME=secure-files

# Azure Configuration
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_KEY=your-storage-key

# Twilio SMS (password reset, security alerts, budget alerts)
# For India (+91) recipients: use an Indian Twilio number OR enable India under
# Twilio Console → Messaging → Geo permissions. US-only numbers (+1) cannot SMS +91 without that.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+919876543210
# Optional: use a Messaging Service instead of TWILIO_PHONE_NUMBER (recommended for multi-country)
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# API Configuration
API_PORT=8000
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

# Google SSO (optional — enable in Admin → Settings)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
