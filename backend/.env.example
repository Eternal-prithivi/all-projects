# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017/cloud_optimization

# AWS Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_ZONE=us-central1-a
GCP_SERVICE_ACCOUNT_JSON_PATH=/path/to/service-account.json

# GCP Billing (for Cost Analysis)
GCP_BILLING_DATASET_ID=billing_dataset
GCP_BILLING_TABLE_ID=gcp_billing_export_v1_XXXXXX

# Azure Credentials
AZURE_STORAGE_CONNECTION_STRING=your_azure_connection_string
AZURE_STORAGE_ACCOUNT_NAME=your_account_name
AZURE_STORAGE_ACCOUNT_KEY=your_account_key
AZURE_STORAGE_CONTAINER_NAME=secure-files

# Azure Configuration
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_KEY=your-storage-key

# Twilio SMS (password reset, security alerts, budget alerts)
# For India (+91) recipients: use an Indian Twilio number OR enable India under
# Twilio Console → Messaging → Geo permissions. US-only numbers (+1) cannot SMS +91 without that.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+919876543210
# Optional: use a Messaging Service instead of TWILIO_PHONE_NUMBER (recommended for multi-country)
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# API Configuration
API_PORT=8000
ENVIRONMENT=development
# Optional: always grant these Zenith usernames a plan on this deployment (comma-separated)
# PLATFORM_OWNER_USERNAMES=your_username
# PLATFORM_OWNER_PLAN=enterprise
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
# Comma-separated extra CORS origins (production custom domains / previews)
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://preview.example.com

# Observability (optional — see docs/setup/SENTRY_SETUP.md; not GCP/AWS keys)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Frontend (.env.local in frontend/ folder):
# VITE_SENTRY_DSN=
# VITE_TURNSTILE_SITE_KEY=   # Cloudflare Turnstile site key (register CAPTCHA)

# Google SSO (optional — enable in Admin → Settings)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Signup trust — genuine email + bot protection
# Gmail app password for verification emails (see Google Account → Security → App passwords)
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=
# Force email verification on/off (unset = platform_settings / production default)
# REQUIRE_EMAIL_VERIFICATION=true
# Cloudflare Turnstile secret (server-side CAPTCHA verify)
# TURNSTILE_SECRET_KEY=
# Extra disposable domains to block (comma-separated)
# DISPOSABLE_EMAIL_DOMAINS=temp-mail.org,maildrop.cc

# Demo / live billing (see docs/setup/DEMO_MODE_TRANSITION.md)
# DEMO_MODE=true  → mock Cost Explorer / GCP / Azure billing reads (no billing API charges)
# DEMO_MODE=false → real billing APIs when credentials are configured
DEMO_MODE=true
USE_REAL_METRICS=false
REAL_TIME_MODE=false

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
